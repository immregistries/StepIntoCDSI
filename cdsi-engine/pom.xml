<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.openimmunizationsoftware.cdsi</groupId>
		<artifactId>cdsi-parent</artifactId>
		<version>5.4.0</version>
	</parent>

	<artifactId>cdsi-engine</artifactId>
	<packaging>jar</packaging>
	<name>StepIntoCDSi Engine</name>
	<description>The CDSi calculation engine: supporting-data loading, domain model, and the CDSi processing-model steps. No servlet/web dependency - runs headlessly.</description>

	<dependencies>
		<dependency>
			<groupId>javax.xml.parsers</groupId>
			<artifactId>jaxp-api</artifactId>
			<version>1.4.5</version>
		</dependency>

		<dependency>
			<groupId>joda-time</groupId>
			<artifactId>joda-time</artifactId>
			<version>2.13.0</version>
		</dependency>

		<!-- Commons Lang 2.x for legacy DateUtils -->
		<dependency>
			<groupId>commons-lang</groupId>
			<artifactId>commons-lang</artifactId>
			<version>2.6</version>
		</dependency>

		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>4.13.1</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- The engine is consumed as a plain dependency by other Java projects, at least
			     one of which runs on Java 8, so the engine alone targets Java 8. cdsi-web and
			     cdsi-fits-tests stay on the parent's Java 17. release=8 makes javac check
			     against the Java 8 API, so a Java 9+ language feature or library call is a
			     compile error rather than a runtime surprise. -Xlint:-options silences
			     JDK 21+'s "release 8 is deprecated" warning. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<release>8</release>
					<compilerArgs>
						<arg>-Xlint:-options</arg>
					</compilerArgs>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- Run the engine's unit tests on a real Java 8 JVM (the build itself still runs
		     on JDK 17+): mvn -pl cdsi-engine test -Djava8.home="C:\Program Files\Java\jdk1.8.0_202" -->
		<profile>
			<id>java8-runtime-tests</id>
			<activation>
				<property>
					<name>java8.home</name>
				</property>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<jvm>${java8.home}/bin/java</jvm>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
