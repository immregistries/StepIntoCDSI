<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.openimmunizationsoftware.cdsi</groupId>
		<artifactId>cdsi-parent</artifactId>
		<version>5.3.4</version>
	</parent>

	<artifactId>cdsi-fits-tests</artifactId>
	<packaging>jar</packaging>
	<name>StepIntoCDSi FITS Tests</name>
	<description>
		Runs the CDC/NIST FITS (Forecast for Immunization Test Suite) test cases
		against cdsi-engine directly, offline: no servlet container, no live NIST
		connection, no browser. Test cases are downloaded once (FitsDownloader,
		run by hand against a real NIST FITS account) and frozen as JSON fixtures
		under src/test/resources/fits/, which is what the JUnit tests actually run
		against. This is the mechanism intended to let an AI agent (or a human)
		run and debug FITS conformance failures directly against the engine, with
		full FITS-suite regression checked by a normal `mvn test` run.
	</description>

	<properties>
		<jackson.version>2.18.2</jackson.version>
		<junit.jupiter.version>5.11.4</junit.jupiter.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.openimmunizationsoftware.cdsi</groupId>
			<artifactId>cdsi-engine</artifactId>
			<version>${project.version}</version>
		</dependency>

		<!-- JSON fixture (de)serialization -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<version>${jackson.version}</version>
		</dependency>

		<!-- JUnit 5, for @ParameterizedTest/@MethodSource over the fixture set -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${junit.jupiter.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
			<version>${junit.jupiter.version}</version>
			<scope>test</scope>
		</dependency>

		<!--
		Used only by FitsDownloader (org.openimmunizationsoftware.cdsi.fitstests.download),
		the dev-time tool that talks to a live NIST FITS account and writes the
		JSON fixtures below. Not needed at all to run the JUnit tests themselves.
		-->
		<dependency>
			<groupId>gov.nist.healthcare.cds.client</groupId>
			<artifactId>fits-client</artifactId>
			<version>1.2.1-AIRA-1.1</version>
		</dependency>
		<dependency>
			<groupId>gov.nist.healthcare.cds</groupId>
			<artifactId>cds-base-domain</artifactId>
			<version>1.0.1</version>
			<exclusions>
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>gov.nist.healthcare.cds</groupId>
			<artifactId>cds-base-auth</artifactId>
			<version>1.0.1</version>
			<exclusions>
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>gov.nist.healthcare.cds</groupId>
			<artifactId>cds-base-utils</artifactId>
			<version>1.0.1</version>
			<exclusions>
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.apache.httpcomponents.client5</groupId>
			<artifactId>httpclient5</artifactId>
			<version>5.2.1</version>
		</dependency>
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-lang3</artifactId>
			<version>3.18.0</version>
		</dependency>
		<!-- fits-client's FITSClient returns Spring's ResponseEntity -->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-web</artifactId>
			<version>${spring.version}</version>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-core</artifactId>
			<version>${spring.version}</version>
		</dependency>
	</dependencies>

	<repositories>
		<repository>
			<id>data-local</id>
			<name>data</name>
			<url>file://${project.basedir}/../repo</url>
		</repository>
	</repositories>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.2.5</version>
			</plugin>
		</plugins>
	</build>

</project>
