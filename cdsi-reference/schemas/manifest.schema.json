{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stepintocdsi/cdsi-reference/schemas/manifest.schema.json",
  "title": "Logic Specification version manifest",
  "type": "object",
  "required": ["specification", "version", "source_filename", "sha256", "page_count", "extraction_tool_version", "extracted_at"],
  "properties": {
    "specification": { "type": "string" },
    "version": { "type": "string" },
    "publication_date": { "type": "string" },
    "source_filename": { "type": "string" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "page_count": { "type": "integer", "minimum": 1 },
    "extraction_tool_version": { "type": "string" },
    "extracted_at": { "type": "string" }
  },
  "additionalProperties": true
}
