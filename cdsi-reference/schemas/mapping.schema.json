{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stepintocdsi/cdsi-reference/schemas/mapping.schema.json",
  "title": "mappings/spec-to-code.yaml",
  "type": "object",
  "required": ["spec_version", "sections"],
  "properties": {
    "spec_version": { "type": "string" },
    "sections": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["title", "implementation", "mapping_status"],
        "properties": {
          "title": { "type": "string" },
          "implementation": {
            "type": "object",
            "properties": {
              "module": { "type": "string" },
              "classes": { "type": "array", "items": { "type": "string" } }
            }
          },
          "tests": { "type": "array", "items": { "type": "string" } },
          "mapping_status": { "type": "string", "enum": ["reviewed", "draft", "unmapped"] }
        }
      }
    },
    "unmapped_classes": {
      "type": "object",
      "description": "Real, instantiable LogicStepType classes that don't fit the numbered-section step-package model (e.g. their enum constant carries a placeholder or bare-chapter section label, not a real subsection number). Acknowledging a class here tells the Phase 8 validator its gap is known and tracked, not silently missed - it stays visible via `note`, but stops failing `logic-spec validate`.",
      "additionalProperties": {
        "type": "object",
        "required": ["enum_name", "class", "note"],
        "properties": {
          "enum_name": { "type": "string" },
          "class": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
